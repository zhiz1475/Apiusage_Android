{
  "name": "apiusagebar",
  "version": "0.1.9",
  "description": "Kapibala account usage monitor for Windows",
  "main": "main.cjs",
  "private": true,
  "author": "ApiUsageBar",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "mobile:preview": "py -m http.server 4173 --directory mobile",
    "mobile:bundle": "esbuild mobile/capacitor-plugins-entry.js --bundle --format=esm --platform=browser --outfile=mobile/capacitor-plugins.js",
    "mobile:preview:capture": "electron capture-mobile-preview.cjs",
    "mobile:verify": "electron verify-mobile-ui.cjs",
    "cap:sync": "cap sync android",
    "android:open": "cap open android",
    "android:debug": "cap run android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.9"
  },
  "build": {
    "appId": "com.apiusagebar.kapibala",
    "productName": "ApiUsageBar",
    "artifactName": "ApiUsageBar-Setup-${version}-${arch}.${ext}",
    "files": [
      "index.html",
      "styles.css",
      "window-overrides.css",
      "layout-v021.css",
      "app.js",
      "main.cjs",
      "preload.cjs",
      "kapibala-client.cjs",
      "assets/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "assets/kapibala-logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ApiUsageBar-Setup-${version}-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ApiUsageBar",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1"
  }
}
